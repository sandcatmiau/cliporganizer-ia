import { IncomingForm } from 'formidable';
import fs from 'fs';

export const config = { api: { bodyParser: false } };

export default async function handler(req, res) {
    if (req.method !== 'POST') return res.status(405).json({ error: 'Método no permitido' });

    const form = new IncomingForm();
    form.parse(req, async (err, fields, files) => {
        if (err) return res.status(500).json({ decision: 'CLIP' });

        const archivoAudio = files.audio?. || files.audio;
        // Si el extractor local falló por códec, usamos regla de nombre por seguridad
        if (!archivoAudio) {
            const nombre = fields.nombreOriginal?.[0] || fields.nombreOriginal || "";
            const n = nombre.toLowerCase();
            if (n.includes('hook') || n.includes('intro')) return res.status(200).json({ decision: 'HOOK' });
            if (n.includes('error') || n.includes('toma')) return res.status(200).json({ decision: 'TRASH' });
            return res.status(200).json({ decision: 'CLIP' });
        }

        const GROQ_API_KEY = "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";

        try {
            const streamDeAudio = fs.createReadStream(archivoAudio.filepath);
            const formDataAudio = new FormData();
            formDataAudio.append('file', streamDeAudio, 'audio.wav');
            formDataAudio.append('model', 'whisper-large-v3');
            formDataAudio.append('language', 'es');

            // Enviamos el audio de 300KB sin bloqueos de tamaño
            const respuestaWhisper = await fetch("https://groq.com", {
                method: "POST",
                headers: { "Authorization": `Bearer ${GROQ_API_KEY}` },
                body: formDataAudio
            });

            const datosTrans = await respuestaWhisper.json();
            const textoHablado = datosTrans.text || "";

            const respuestaLlama = await fetch("https://groq.com", {
                method: "POST",
                headers: { "Authorization": `Bearer ${GROQ_API_KEY}`, "Content-Type": "application/json" },
                body: JSON.stringify({
                    model: "llama3-8b-8192",
                    messages: [
                        { role: "system", content: "Eres un editor de video experto. Analiza el texto transcrito de un clip. Responde UNICAMENTE con: 'HOOK' si el texto denota un gancho inicial potente, 'TRASH' si el locutor se equivoca, tartamudea o pide repetir la toma, o 'CLIP' si es desarrollo normal." },
                        { role: "user", content: `Analiza esta transcripción: "${textoHablado}"` }
                    ],
                    temperature: 0.1
                })
            });

            const datosLlama = await respuestaLlama.json();
            const decisionFinal = datosLlama.choices?.[0]?.message?.content?.toUpperCase() || "CLIP";

            return res.status(200).json({ decision: decisionFinal });

        } catch (e) {
            return res.status(500).json({ decision: 'CLIP', error: e.message });
        }
    });
}

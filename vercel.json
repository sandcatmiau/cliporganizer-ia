{
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy", 
          "value": "require-corp"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/anuncios-limpios/:path*",
      "destination": "https://untimely-hello.com*"
    }
  ]
}
